# ============================================================
# PRATIKSHYA FASHION BACKEND — Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# --- App ---
APP_NAME="Pratikshya Fashion Backend"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
# Comma-separated or JSON array — both parse correctly now.
# Add the Vite dev origin(s) used by the frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# --- Database ---
# Local development default (no Docker): point at your existing PostgreSQL server.
# Example: postgresql+asyncpg://user:password@ltrdrocalhost:5432/pratikshya_fashion
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pratikshya_fashion
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Celery (task queue — still uses Redis as broker) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Object Storage (provider-agnostic) ------------------------------------
# Full plan, AWS resource list and rollback runbook:
#   docs/PRODUCT_MEDIA_S3_CDN_IMPLEMENTATION_PLAN.md
#
# `local`  → development and automated tests. Filesystem-backed object store
#            that behaves like object storage (object keys, put/get/delete/
#            exists, content types, application-level URLs) with NO AWS
#            credentials, Docker, MinIO, Redis or Celery.
# `s3`     → staging and production. Real S3 + CloudFront delivery.
#
# APP_ENV drives the guards: production REFUSES to start on `local`, and a
# non-production environment REFUSES to use a bucket listed in
# MEDIA_PROTECTED_BUCKETS.
STORAGE_PROVIDER=local

# --- Local object storage (development provider) ---
# Root of the local object store. A relative value resolves against the
# backend directory, so nothing is machine-specific. This directory persists
# across restarts — do NOT point it at a temp folder, and NEVER point it at
# the frontend mock asset directory: `frontend/public/images` is the mock/
# development library and is served by Vite, not used as an upload target.
LOCAL_MEDIA_ROOT=storage/media
# Application-level media URL prefix, mounted under API_V1_PREFIX:
#   /api/v1 + /media/objects + /{object_key}
# The frontend only ever receives this shape — never a filesystem path.
MEDIA_URL_PREFIX=/media/objects
API_V1_PREFIX=/api/v1
# Single source of truth for CDN delivery. When set, media URLs become
# {MEDIA_CDN_BASE_URL}/{object_key} and the CDN fronts the object store
# directly (CloudFront + S3 Origin Access Control). Leave empty until the
# distribution actually exists.
#
# MUST be an https:// origin with no trailing slash, and is REQUIRED when
# APP_ENV=production.
#
# NOTE: the old `CDN_BASE_URL` variable has been REMOVED — it was declared but
# never read by any code path, and having two CDN settings was a trap. Do not
# re-add it.
MEDIA_CDN_BASE_URL=
# Rewrite product image references onto canonical media URLs when the object
# exists in the configured store. Set to false to restore the pre-Phase-6
# behaviour (references passed through verbatim).
MEDIA_RESOLVE_PRODUCT_IMAGES=true

# --- Storage safety guards --------------------------------------------------
# Buckets that may ONLY be used when APP_ENV=production. Put the production
# bucket name here in every other environment so a copied .env can never aim
# staging or a dev machine at production media.
MEDIA_PROTECTED_BUCKETS=
# Automated tests must never reach a real bucket. Keep false; set to true only
# for a deliberate, supervised staging soak test.
MEDIA_TEST_ALLOW_REMOTE_STORAGE=false
# The local-media importer copies the DEVELOPMENT MOCK asset library. It must
# never be written to a real bucket: the first objects in production have to be
# deliberate, genuine uploads. Keep false — flipping this to true is what
# allows the mock library to be seeded into a remote bucket.
MEDIA_MIGRATION_ALLOW_REMOTE_STORAGE=false

# --- Local media import (development migration tool) ---
# READ-ONLY source for:
#   python -m app.services.media.migrate_local --dry-run
#   python -m app.services.media.migrate_local
# The importer only copies FROM this folder; it never writes to it. The files
# here are MOCK/development assets — they are never migrated to S3.
# (The previous default pointed at ../../frontend/pratikshya-frontend/public/
# images, a path that has never existed in this project.)
LOCAL_MEDIA_IMPORT_SOURCE=../frontend/public/images

# --- AWS S3 + CloudFront (staging / production) -----------------------------
# Fill these in only when the bucket, the CloudFront distribution and the IAM
# role have actually been provisioned. They are never required by the local
# provider and are never logged and never returned by any API response.
#
# PREFERRED: attach a least-privilege workload role (IRSA / ECS task role /
# EC2 instance profile) and OMIT the access key pair entirely. Only fall back
# to these two variables on a host that cannot do workload identity, and then
# inject them from the platform secret manager — never commit them.
#
# The placeholder values below are treated as "not configured" on purpose, so
# a copied-but-unfilled .env can never be mistaken for real credentials.
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
# staging:   a dedicated staging bucket — never the production bucket
# production: the production media bucket (private, versioned, encrypted)
AWS_BUCKET_NAME=pratikshya-fashion-media
# Optional custom / VPC endpoint. Leave empty for real AWS.
AWS_ENDPOINT_URL=
# Server-side encryption for every object the S3 provider writes.
#   AES256  → SSE-S3 (default, no extra resource)
#   aws:kms → SSE-KMS, and then AWS_S3_SSE_KMS_KEY_ID is required
AWS_S3_SSE_ALGORITHM=AES256
AWS_S3_SSE_KMS_KEY_ID=

# --- Payment (Razorpay) ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Email ---
MAIL_USERNAME=noreply@pratikshyafashion.com
MAIL_PASSWORD=your-mail-password
MAIL_FROM=noreply@pratikshyafashion.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=true

# --- SMS / WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# --- AI / LLM ---
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama3-8b-8192
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG / Vector ---
VECTOR_SEARCH_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- File Upload Limits ---
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
# image/avif is part of the house policy: the real product asset library is
# AVIF-first (228 of the 238 shipped assets carry a .avif name).
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/avif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm
# Decompression-bomb / dimension guard, on top of the size ceiling.
# Only enforced for formats Pillow can DECODE — AVIF needs pillow-avif-plugin,
# so an AVIF upload skips the geometry check rather than being rejected, and is
# still protected by its content signature and the size ceiling.
# 0 disables the respective check.
MAX_IMAGE_PIXELS=50000000
MAX_IMAGE_DIMENSION_PX=8000

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Attendance machines (ADMS push: /iclock/*) ---
# Comma-separated source IPs allowed to push punches. Empty = any IP (serial
# number still must be a registered, active device). Device serials are not
# secret, so set this to the mall's public IP in production.
ADMS_ALLOWED_IPS=

# --- OAuth (Social Login) ---
# Google: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook: https://developers.facebook.com/ → My Apps → Your App → Settings → Basic
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Frontend base URL for OAuth redirects (server-side flows)
OAUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback

# --- Admin Bootstrap ---
# Set this to gate the first admin account creation endpoint.
# Remove or leave blank to disable the gate (only safe if no admins exist yet).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_BOOTSTRAP_SECRET=your-bootstrap-secret-change-me

# --- Instagram Customer Reward Coupon ---
# Discount percentage given to customers who post about their purchase on
# Instagram and tag the official Pratikshya Fashion account.
# Staff verify the post manually, then generate a one-time personal coupon
# from the Admin portal. The percentage is read exclusively from this variable
# — it is never hardcoded in business logic.
# Rules: must be > 0 and <= 100.
INSTAGRAM_REWARD_DISCOUNT_PERCENT=10
