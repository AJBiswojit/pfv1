# ============================================================
# PRATIKSHYA FASHON BACKEND — Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# --- App ---
APP_NAME="Pratikshya Fashon Backend"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
# Comma-separated or JSON array — both parse correctly now.
# Add the Vite dev origin(s) used by the frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# --- Database ---
# Local development default (no Docker): point at your existing PostgreSQL server.
# Example: postgresql+asyncpg://user:password@localhost:5432/pratikshya_fashon
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pratikshya_fashon
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Celery (task queue — still uses Redis as broker) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Object Storage (AWS S3 / compatible) ---
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=pratikshya-fashon-media
CDN_BASE_URL=https://cdn.pratikshyafashon.com

# --- Payment (Razorpay) ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Email ---
MAIL_USERNAME=noreply@pratikshyafashon.com
MAIL_PASSWORD=your-mail-password
MAIL_FROM=noreply@pratikshyafashon.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=true

# --- SMS / WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# --- AI / LLM ---
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama3-8b-8192
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG / Vector ---
VECTOR_SEARCH_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- File Upload Limits ---
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/webm

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- OAuth (Social Login) ---
# Google: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook: https://developers.facebook.com/ → My Apps → Your App → Settings → Basic
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Frontend base URL for OAuth redirects (server-side flows)
OAUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback

# --- Admin Bootstrap ---
# Set this to gate the first admin account creation endpoint.
# Remove or leave blank to disable the gate (only safe if no admins exist yet).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_BOOTSTRAP_SECRET=your-bootstrap-secret-change-me
